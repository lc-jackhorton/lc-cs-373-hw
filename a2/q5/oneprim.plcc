# Language V0, complete: the lexical and syntactic sections from the textbook
# chapter, plus the semantic section the chapter points at.
# primitive expressions
skip WHITESPACE '\s+'
skip COMMENT '%.*'
token LIT '\d+'
token LPAREN '\('
token RPAREN '\)'
token COMMA ','
token PRIMOP '\+|-|add1|sub1'
token SYMBOL '[A-Za-z]\w*'
%
<Program>        ::= <Exp>
<Exp:LitExp>     ::= <LIT>
<Exp:VarExp>     ::= <SYMBOL>
<Exp:PrimappExp> ::= <PRIMOP> LPAREN <Rands> RPAREN
<Rands>          **= <Exp> +COMMA

%
Python

Program
%%%
def _run(self):
    return str(self.exp)
%%%

PrimappExp
%%%
def __str__(self):
    return f"{self.primop}({self.rands})"
%%%

Rands
%%%
def __str__(self):
    return ",".join(str(e) for e in self.expList)
%%%

LitExp
%%%
def __str__(self):
    return self.lit.lexeme
%%%

VarExp
%%%
def __str__(self):
    return self.symbol.lexeme
%%%

AddPrim
%%%
def __str__(self):
    return "+"
%%%

SubPrim
%%%
def __str__(self):
    return "-"
%%%

Add1Prim
%%%
def __str__(self):
    return "add1"
%%%

Sub1Prim
%%%
def __str__(self):
    return "sub1"
%%%
